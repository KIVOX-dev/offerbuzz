# ---- API (apps/api) ----
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017/offerbuzz
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# JWT (use long random strings, e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Secret used to HMAC OTP codes before storing them
OTP_SECRET=change-me-otp-secret-at-least-32-chars

# When true the OTP is printed to the API log and also returned as devOtp. NEVER true in production.
OTP_DEV_MODE=true

# Google sign in (OAuth web client id; app client ids can be added comma separated)
GOOGLE_CLIENT_IDS=

# Brevo (email only). Login codes fall back to the API log in dev mode when no key is set.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@offerbuzz.co
BREVO_SENDER_NAME=OfferBuzz

# Admin seed (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@offerbuzz.co
ADMIN_PASSWORD=change-me-admin-password

# ---- Web (apps/web) ----
PORT_WEB=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Backblaze B2 (Phase 3 uploads)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Optional: override DNS if mongodb+srv lookups fail locally
DNS_SERVERS=
