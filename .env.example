# ---- API (apps/api) ----
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://localhost:27017/offerbuzz
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# JWT (use long random strings, e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Secret used to HMAC OTP codes before storing them
OTP_SECRET=change-me-otp-secret-at-least-32-chars

# When true the OTP is printed to the API log and also returned as devOtp. NEVER true in production.
OTP_DEV_MODE=true

# Google sign in (OAuth web client id; app client ids can be added comma separated). Must be set on the API server
# (Zoho Catalyst) AND NEXT_PUBLIC_GOOGLE_CLIENT_ID on the website (Vercel), with the same value. No client secret needed.
GOOGLE_CLIENT_IDS=

# Brevo (email only). Login codes fall back to the API log in dev mode when no key is set.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@offerbuzz.co
BREVO_SENDER_NAME=OfferBuzz

# Google Maps: ONE key shared by web, Android and the API (never commit the real value).
# Enable: Maps JavaScript API, Places API (New), Geocoding API, Maps SDK for Android, Places SDK for Android.
# The web build copies it into the browser bundle (see apps/web/next.config.js). Set a budget alert and quotas in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Offera AI (the offers assistant). Free key from https://console.groq.com -> API Keys. Without a key the assistant still
# answers, straight from the live offers, just without the AI model.
GROQ_API_KEY=
# Models are tried in this order; when one is rate limited or down the next is used. Edit if Groq retires a model.
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant,openai/gpt-oss-120b,openai/gpt-oss-20b

# Admin seed (used by `npm run seed:admin`)
ADMIN_EMAIL=admin@offerbuzz.co
ADMIN_PASSWORD=change-me-admin-password

# ---- Web (apps/web) ----
PORT_WEB=3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Backblaze B2 (Phase 3 uploads)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Optional: override DNS if mongodb+srv lookups fail locally
DNS_SERVERS=
